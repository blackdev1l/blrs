# Cross-compilation image for Raspberry Pi.
#
# Builds TWO targets, because we cannot assume a 32-bit or a 64-bit userland:
#   aarch64-unknown-linux-gnu      Pi 3/4/5 on a 64-bit OS (arm64 / aarch64)
#   armv7-unknown-linux-gnueabihf  Pi 2/3/4/5 on a 32-bit OS (armv7l)
# An aarch64 binary on a 32-bit userland fails with "Exec format error", and
# DietPi in particular is installed as either, so ship both and let the deploy
# script pick by `uname -m`.
#
# Debian **bullseye** rather than bookworm on purpose: the binary links against
# this image's glibc, so the older base gives the lower floor (>= 2.31) and one
# artifact runs on both bullseye and bookworm hosts.
#
# Build:  docker build -t blrs-pi:1 -f docker/Dockerfile.pi docker/
FROM rust:1-bullseye

RUN rustup target add aarch64-unknown-linux-gnu armv7-unknown-linux-gnueabihf \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      gcc-aarch64-linux-gnu \
      libc6-dev-arm64-cross \
      gcc-arm-linux-gnueabihf \
      libc6-dev-armhf-cross \
      file \
 && rm -rf /var/lib/apt/lists/*

# rusqlite's bundled SQLite and secp256k1-sys both compile C, so CC must be set
# per target, not just the Rust linker.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
ENV AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar

ENV CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc
ENV CC_armv7_unknown_linux_gnueabihf=arm-linux-gnueabihf-gcc
ENV AR_armv7_unknown_linux_gnueabihf=arm-linux-gnueabihf-ar
# Rust's armv7 target defaults to a conservative feature set; the Pi 2 and up
# are Cortex-A7 or better, so enable v7 explicitly rather than shipping a v6
# binary that silently runs slower.
ENV CFLAGS_armv7_unknown_linux_gnueabihf=-march=armv7-a
